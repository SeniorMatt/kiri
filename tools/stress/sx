#!/bin/sh
# run a command inside the nested session started by start.sh (idle driver): sx qdbus6 ...
P=$(cat /st/kwin.pid)
export XDG_RUNTIME_DIR=/tmp/xdgst HOME=/tmp/sthome WAYLAND_DISPLAY=wayland-0 QT_QPA_PLATFORM=offscreen
export DBUS_SESSION_BUS_ADDRESS=$(tr '\0' '\n' < /proc/$P/environ | grep '^DBUS_SESSION_BUS_ADDRESS=' | cut -d= -f2-)
export KWIN_SCREENSHOT_NO_PERMISSION_CHECKS=1
exec "$@"
