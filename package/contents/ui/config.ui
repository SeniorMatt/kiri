</layout></item><item><spacer name="spacer_shortcuts_10"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget></widget></item></layout></item></layout></widget><widget class="QWidget" name="tab_Advanced"><attribute name="title"><string>Advanced</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_Advanced"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_Advanced"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Stacking order</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Tiled windows</string></property><property name="toolTip"><string>Sets "Keep Below" on tiled windows so floating ones stay on top</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QRadioButton" name="kcfg_tiledKeepBelow"><property name="text"><string>Keep below</string></property><property name="toolTip"><string>Sets "Keep Below" on tiled windows so floating ones stay on top</string></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Floating windows</string></property><property name="toolTip"><string>Sets "Keep Above" on floating windows</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QRadioButton" name="kcfg_floatingKeepAbove"><property name="text"><string>Keep above</string></property><property name="toolTip"><string>Sets "Keep Above" on floating windows</string></property></widget></item><item row="2" column="1"><widget class="QRadioButton" name="kcfg_noLayering"><property name="text"><string>Do not change it</string></property><property name="toolTip"><string>Leave the stacking order to KWin</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Desktops</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Dynamic desktops</string></property><property name="toolTip"><string>Experimental, off by default. Like niri's workspaces: there is always one empty desktop at the bottom, and empty desktops are removed when you leave them. Moving a window or column down from the last desktop opens a new one</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QCheckBox" name="kcfg_dynamicDesktops"><property name="text"><string>Always keep one empty desktop (experimental)</string></property><property name="toolTip"><string>Experimental, off by default. Like niri's workspaces: there is always one empty desktop at the bottom, and empty desktops are removed when you leave them. Moving a window or column down from the last desktop opens a new one</string></property></widget></item><item row="1" column="1"><widget class="QCheckBox" name="kcfg_emptyDesktopAboveFirst"><property name="text"><string>Keep an empty desktop above the first too</string></property><property name="toolTip"><string>With dynamic desktops: also keep an empty desktop above the first one (niri: empty-workspace-above-first)</string></property></widget></item><item row="2" column="1"><widget class="QCheckBox" name="kcfg_desktopAutoBackAndForth"><property name="text"><string>Go back when switching to the current desktop</string></property><property name="toolTip"><string>Switching to the desktop you are on goes back to the previous one (niri: workspace-auto-back-and-forth)</string></property></widget></item><item row="3" column="0"><widget class="QLabel"><property name="text"><string>Named desktops</string></property><property name="toolTip"><string>Desktops that always exist, at the top, in this order (niri: workspace "name"). A JSON list, e.g. ["web", "chat"]. The niri import fills it</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="kcfg_namedDesktops"><property name="toolTip"><string>Desktops that always exist, at the top, in this order (niri: workspace "name"). A JSON list, e.g. ["web", "chat"]. The niri import fills it</string></property><property name="placeholderText"><string>["web", "chat"]</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="4" column="0"><widget class="QLabel"><property name="text"><string>Layout per desktop</string></property><property name="toolTip"><string>niri: workspace "name" { layout { } }. A JSON object: a desktop's name -&gt; the layout settings it changes (the setting names of this dialog: gapsInnerHorizontal, gapsInnerVertical, gapsOuterTop/Bottom/Left/Right, presetWidths, presetHeights, defaultColumnWidth, scrollingLazy/Centered/OnOverflow, alwaysCenterSingleColumn, tabbedColumnsByDefault, tabIndicator*, focusRing*, border*, shadow*, backgroundColor, fullscreenBackdropColor). It wins over the output's layout, which wins over the settings of the tabs. The niri import fills it</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="4" column="1"><widget class="QPlainTextEdit" name="kcfg_desktopLayouts"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>niri: workspace "name" { layout { } }. A JSON object: a desktop's name -&gt; the layout settings it changes (the setting names of this dialog: gapsInnerHorizontal, gapsInnerVertical, gapsOuterTop/Bottom/Left/Right, presetWidths, presetHeights, defaultColumnWidth, scrollingLazy/Centered/OnOverflow, alwaysCenterSingleColumn, tabbedColumnsByDefault, tabIndicator*, focusRing*, border*, shadow*, backgroundColor, fullscreenBackdropColor). It wins over the output's layout, which wins over the settings of the tabs. The niri import fills it</string></property><property name="placeholderText"><string>{"web": {"gapsInnerHorizontal": 0, "presetWidths": "1/3, 2/3"}}</string></property><property name="minimumSize"><size><width>0</width><height>82</height></size></property><property name="maximumSize"><size><width>16777215</width><height>82</height></size></property></widget></item><item row="5" column="0"><widget class="QLabel"><property name="text"><string>Settings per output</string></property><property name="toolTip"><string>niri: output "name" { layout { } backdrop-color hot-corners }. A JSON object: an output's name ("DP-1", or "Make Model Serial") -&gt; {"layout": {the same settings as above}, "backdropColor": "#101010" (the overview's), "hotCorners": {"enabled": true, "topLeft": true, "topRight": false, "bottomLeft": false, "bottomRight": false}}. The niri import fills it</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="5" column="1"><widget class="QPlainTextEdit" name="kcfg_outputOverrides"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>niri: output "name" { layout { } backdrop-color hot-corners }. A JSON object: an output's name ("DP-1", or "Make Model Serial") -&gt; {"layout": {the same settings as above}, "backdropColor": "#101010" (the overview's), "hotCorners": {"enabled": true, "topLeft": true, "topRight": false, "bottomLeft": false, "bottomRight": false}}. The niri import fills it</string></property><property name="placeholderText"><string>{"DP-1": {"layout": {"gapsInnerHorizontal": 4}, "backdropColor": "#101010"}}</string></property><property name="minimumSize"><size><width>0</width><height>82</height></size></property><property name="maximumSize"><size><width>16777215</width><height>82</height></size></property></widget></item><item row="6" column="0"><widget class="QLabel"><property name="text"><string>Names for shortcuts</string></property><property name="toolTip"><string>The names the "Desktop: focus named N" shortcuts go to, Nth name for N (a JSON list). The niri import fills it</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="6" column="1"><widget class="QLineEdit" name="kcfg_desktopBindNames"><property name="toolTip"><string>The names the "Desktop: focus named N" shortcuts go to, Nth name for N (a JSON list). The niri import fills it</string></property><property name="placeholderText"><string>["web", "chat"]</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="7" column="0"><widget class="QLabel"><property name="text"><string>Tiled desktops</string></property><property name="toolTip"><string>Regular expression matched against the virtual desktop names. Only matching desktops are tiled</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="7" column="1"><widget class="QLineEdit" name="kcfg_tiledDesktops"><property name="toolTip"><string>Regular expression matched against the virtual desktop names. Only matching desktops are tiled</string></property><property name="placeholderText"><string>.* (all)</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Import niri config</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Kiri applies the pasted config on top of the other tabs. Hover over the box for what it reads.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_niriConfigEnabled"><property name="text"><string>Use this niri config</string></property><property name="toolTip"><string>When off, the pasted text is kept but not used</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_niriConfig"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>Paste your niri config.kdl (usually ~/.config/niri/config.kdl). Kiri reads it every time the settings change and applies it on top of the other tabs, so the values it sets win. It sets: key binds (keys typed in the Shortcuts tab still win), gaps and struts, center-focused-column, always-center-single-column, preset widths and heights, default column width and display, focus ring, border, tab indicator, warp-mouse-to-focus, and window rules (every matcher and property of niri's window-rule that KWin can do). Everything else is ignored; lines Kiri can't use are listed in the KWin log.</string></property><property name="placeholderText"><string>layout {
    gaps 16
}
binds {
    Mod+H { focus-column-left; }
}</string></property><property name="minimumSize"><size><width>0</width><height>252</height></size></property></widget></item></layout></widget></item><item><spacer name="spacer_Advanced"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget></widget></item></layout></widget>
