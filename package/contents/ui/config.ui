e="placeholderText"><string>33.333%, 50%, 66.667%</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Key step</string></property><property name="toolTip"><string>Share of the screen a window grows or shrinks by with the height keys</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="kcfg_windowHeightStep"><property name="suffix"><string> %</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>100</number></property><property name="toolTip"><string>Share of the screen a window grows or shrinks by with the height keys</string></property></widget></item><item row="2" column="0"><widget class="QLabel"><property name="text"><string>Fine key step</string></property><property name="toolTip"><string>Step when making a window taller or shorter with the up/down resize keys</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="2" column="1"><widget class="QSpinBox" name="kcfg_verticalResizeStep"><property name="suffix"><string> px</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>999</number></property><property name="toolTip"><string>Step when making a window taller or shorter with the up/down resize keys</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Centering</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingField