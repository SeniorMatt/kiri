Tip"><string>If every column fits on screen, center them instead of aligning to the left</string></property></widget></item><item row="5" column="1"><widget class="QCheckBox" name="kcfg_alwaysCenterSingleColumn"><property name="text"><string>Always center a single column</string></property><property name="toolTip"><string>A lone column is centered even if the other settings would not</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Scrolling</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Scroll key distance</string></property><property name="toolTip"><string>Distance moved by the scroll left/right keys</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QSpinBox" name="kcfg_manualScrollStep"><property name="suffix"><string> px</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>99999</number></property><property name="toolTip"><string>Distance moved by the scroll left/right keys</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tabbedColumnsByDefault"><property name="text"><string>New columns are tabbed</string></property><property name="toolTip"><string>New columns start in tabbed display (only the active window is visible)</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tileMaximized"><property name="text"><string>Keep maximized windows in the grid</string></property><property name="toolTip"><string>They stay in their column and fill the work area; they stay maximized when focus moves away</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tileFullScreen"><property name="text"><string>Keep full-screen windows in the grid</string></property><property name="toolTip"><string>They stay in their column and fill the screen; you can scroll past them</string></property></widget></item><item row="3" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_reMaximize"><property name="text"><string>Restore maximized and full-screen state on focus</string></property><property name="toolTip"><string>Re-maximize and re-fullscreen tiled windows when they are focused again</string></property></widget></item></layout></widget></item><item><spacer name="spacer_Layout"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_FocusMouse"><attribute name="title"><string>Focus &amp;&amp; Mouse</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_FocusMouse"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_FocusMouse"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Focus</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="1"><widget class="QCheckBox" name="kcfg_focusFollowsMouse"><property name="text"><string>Focus follows mouse</string></property><property name="toolTip"><string>Like niri: the window under the mouse gets the focus, except while a Plasma popup such as the launcher is open. Kiri sets KWin's focus policy to "Click to focus" when installing</string></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Max scroll</string></property><property name="toolTip"><string>Like niri's max-scroll-amount: do not focus a window that needs more scrolling than this to be fully shown, in percent of the screen width</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="kcfg_focusFollowsMouseMaxScroll"><property name="suffix"><string> %</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="toolTip"><string>Like niri's max-scroll-amount: do not focus a window that needs more scrolling than this to be fully shown, in percent of the screen width</string></property></widget></item><item row="2" column="1"><widget class="QCheckBox" name="kcfg_cursorFollowsFocus"><property name="text"><string>Cursor follows keyboard focus</string></property><property name="toolTip"><string>Move the mouse cursor to a window focused from the keyboard (niri: warp-mouse-to-focus)</string></property></widget></item><item row="3" column="1"><widget class="QCheckBox" name="kcfg_skipSwitcher"><property name="text"><string>Hide tiled windows from Alt+Tab</string></property><property name="toolTip"><string>Hide tiled windows from the window switcher</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Dragging windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_untileOnDrag"><property name="text"><string>Float a window when it is dragged</string></property><property name="toolTip"><string>Dragging a tiled window takes it out of the grid</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_dropToTile"><property name="text"><string>Tile a window where it is dropped</string></property><property name="toolTip"><string>Like niri: a window dragged out of the grid goes back in at the gap closest to the cursor when you let go</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_resizeNeighborColumn"><property name="text"><string>Resize the neighbouring column too</string></property><property name="toolTip"><string>When dragging a column's edge, inversely resize the column on the other side</string></property></widget></item></layout></widget></item><item><spacer name="spacer_FocusMouse"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item