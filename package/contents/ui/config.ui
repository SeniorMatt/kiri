idth>130</width><height>0</height></size></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>65535</double></property><property name="singleStep"><double>0.1</double></property><property name="toolTip"><string>In the overview, dragging this close to the top or bottom edge scrolls the desktops (niri dnd-edge-workspace-switch trigger-height)</string></property></widget></item><item row="4" column="0"><widget class="QLabel"><property name="text"><string>Top/bottom delay</string></property><property name="toolTip"><string>How long the pointer must stay in the zone before the desktops scroll</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="4" column="1"><widget class="QSpinBox" name="kcfg_dndEdgeWorkspaceSwitchDelay"><property name="suffix"><string> ms</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><number>0</number></property><property name="maximum"><number>65535</number></property><property name="toolTip"><string>How long the pointer must stay in the zone before the desktops scroll</string></property></widget></item><item row="5" column="0"><widget class="QLabel"><property name="text"><string>Top/bottom max speed</string></property><property name="toolTip"><string>Scroll speed at the very edge</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="5" column="1"><widget class="QDoubleSpinBox" name="kcfg_dndEdgeWorkspaceSwitchMaxSpeed"><property name="decimals"><number>2</number></property><property name="suffix"><string> px/s</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1000000</double></property><property name="singleStep"><double>0.1</double></property><property name="toolTip"><string>Scroll speed at the very edge</string></property></widget></item></layout></widget></item><item><spacer name="spacer_GesturesOverview"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_WindowRules"><attribute name="title"><string>Window Rules</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_WindowRules"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_WindowRules"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Simple rules</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>One window class per line, regular expressions are allowed. Find a class with: qdbus6 org.kde.KWin /KWin org.kde.KWin.queryWindowInfo</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Always float</string></property><property name="toolTip"><string>Window classes that are never tiled. One per line, regular expressions are allowed</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property></widget></item><item row="2" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_floatClasses"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>Window classes that are never tiled. One per line, regular expressions are allowed</string></property><property name="placeholderText"><string>calc
mpv</string></property><property name="minimumSize"><size><width>0</width><height>82</height></size></property><property name="maximumSize"><size><width>16777215</width><height>82</height></size></property></widget></item><item row="3" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Always tile</string></property><property name="toolTip"><string>Window classes that are always tiled, even if Kiri would float them. One per line</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property></widget></item><item row="4" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_tileClasses"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>Window classes that are always tiled, even if Kiri would float them. One per line</string></property><property name="placeholderText"><string>kfind</string></property><property name="minimumSize"><size><width>0</width><height>82</height></size></property><property name="maximumSize"><size><width>16777215</width><height>82</height></size></property></widget></item><item row="5" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Column width</string></property><property name="toolTip"><string>One class=width per line, like firefox=66.667%</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property></widget></item><item row="6" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_columnWidthRules"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>One class=width per line, like firefox=66.667%</string></property><property name="placeholderText"><string>firefox=66.667%
org\.kde\.dolphin=800px</string></property><property name="minimumSize"><size><width>0</width><height>82</height></size></property><property name="maximumSize"><size><width>16777215</width><height>82</height></size></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>JSON rules</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Rules like niri's window-rule, matching the app id and title. Hover over the box for the fields.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Rules</string></property><property name="toolTip"><string>A JSON array of rule objects like niri's window-rule, applied together with the simple rules; the last rule that sets a property wins. Match: class, caption (regexes for the whole string), appId, title (niri's regexes, matching anywhere), isFloating, isActive, isFocused, isActiveInColumn, isUrgent, atStartup; exclude: a list of such matches. Properties: tile (false = open-floating), width, height, fullscreen, maximized, maximizedToEdges, focused, workspace, columnDisplay, floatingPosition {x, y, relativeTo}, minWidth, minHeight, maxWidth, maxHeight, opacity, and the looks focusRing, border, shadow, tabIndicator, cornerRadius, clipToGeometry, drawBorderWithBackground (false: the border and focus ring are outlines only; true: a solid rectangle in their colour under the window, which shows through a see-through window; unset: true for a window that has no KWin title bar), babaIsFloat (the window bobs up and down). Example: {"appId": "^steam$", "title": "Friends List", "tile": false}</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property><property name="alignment"><set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignVCenter</set></property></widget></item><item row="2" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_windowRules"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>A JSON array of rule objects like niri's window-rule, applied together with the simple rules; the last rule that sets a property wins. Match: class, caption (regexes for the whole string), appId, title (niri's regexes, matching anywhere), isFloating, isActive, isFocused, isActiveInColumn, isUrgent, atStartup; exclude: a list of such matches. Properties: tile (false = open-floating), width, height, fullscreen, maximized, maximizedToEdges, focused, workspace, columnDisplay, floatingPosition {x, y, relativeTo}, minWidth, minHeight, maxWidth, maxHeight, opacity, and the looks focusRing, border, shadow, tabIndicator, cornerRadius, clipToGeometry, drawBorderWithBackground (false: the border and focus ring are outlines only; true: a solid rectangle in their colour under the window, which shows through a see-through window; unset: true for a window that has no KWin title bar), babaIsFloat (the window bobs up and down). Example: {"appId": "^steam$", "title": "Friends List", "tile": false}</string></property><property name="minimumSize"><size><width>0</width><height>218</height></size></property></widget></item></layout></widget></item><item><spacer name="spacer_WindowRules"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_Shortcuts"><attribute name="title"><string>Shortcuts</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel" name="label_shortcutsRule"><property name="text"><string>Keys set here are copied to Shortcuts &gt; Kiri in System Settings, without a conflict check. Leave both fields empty to use the keys set there.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><layout class="QHBoxLayout"><item><widget class="QListWidget" name="list_shortcutGroups"><property name="maximumSize"><size><width>170</width><height>16777215</height></size></property><item><property name="text"><string>Focus</string></property></item><item><property name="text"><string>Move</string></property></item><item><property name="text"><string>Column</string></property></item><item><property name="text"><string>Width</string></property></item><item><property name="text"><string>Height</string></property></item><item><property name="text"><string>Window</string></property></item><item><property name="text"><string>Scroll</string></property></item><item><property name="text"><string>Desktop</string></property></item><item><property name="text"><string>Screen</string></property></item><item><property name="text"><string>Overview</string></property></item><item><property name="text"><string>Other</string></property></item></widget></item><item><widget class="QStackedWidget" name="stack_shortcuts"><widget class="QWidget" name="page_shortcuts_0"><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_shortcuts_0"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_shortcuts_0"><layout class="QVBoxLayout"><item><layout class="QGridLayout" name="grid_shortcuts_0"><property name="verticalSpacing"><number>2</number></property>
