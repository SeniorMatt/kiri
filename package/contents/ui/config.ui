verflow"><property name="text"><string>Center it when columns overflow</string></property><property name="toolTip"><string>No scrolling while the focused column fits next to its neighbours, otherwise center it (niri: on-overflow)</string></property></widget></item><item row="3" column="1"><widget class="QRadioButton" name="kcfg_scrollingGrouped"><property name="text"><string>Center all visible columns</string></property><property name="toolTip"><string>Center the group of columns that fit on screen</string></property></widget></item><item row="4" column="1"><widget class="QCheckBox" name="kcfg_centerGridWhenFits"><property name="text"><string>Center all columns when they fit</string></property><property name="toolTip"><string>If every column fits on screen, center them instead of aligning to the left</string></property></widget></item><item row="5" column="1"><widget class="QCheckBox" name="kcfg_alwaysCenterSingleColumn"><property name="text"><string>Always center a single column</string></property><property name="toolTip"><string>A lone column is centered even if the other settings would not</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Scrolling</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Scroll key distance</string></property><property name="toolTip"><string>Distance moved by the scroll left/right keys</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QSpinBox" name="kcfg_manualScrollStep"><property name="suffix"><string> px</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><number>1</number></property><property name="maximum"><number>99999</number></property><property name="toolTip"><string>Distance moved by the scroll left/right keys</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tabbedColumnsByDefault"><property name="text"><string>New columns are tabbed</string></property><property name="toolTip"><string>New columns start in tabbed display (only the active window is visible)</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tileMaximized"><property name="text"><string>Keep maximized windows in the grid</string></property><property name="toolTip"><string>They stay in their column and fill the work area; they stay maximized when focus moves away</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tileFullScreen"><property name="text"><string>Keep full-screen windows in the grid</string></property><property name="toolTip"><string>They stay in their column and fill the screen; you can scroll past them</string></property></widget></item><item row="3" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_reMaximize"><property name="text"><string>Restore maximized and full-screen state on focus</string></property><property name="toolTip"><string>Re-maximize and re-fullscreen tiled windows when they are focused again</string></property></widget></item></layout></widget></item><item><spacer name="spacer_Layout"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_FocusMouse"><attribute name="title"><string>Focus &amp;&amp; Mouse</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_FocusMouse"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_FocusMouse"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Focus</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="1"><widget class="QCheckBox" name="kcfg_focusFollowsMouse"><property name="text"><string>Focus follows mouse</string></property><property name="toolTip"><string>Like niri: the window under the mouse gets the focus, except while a Plasma popup such as the launcher is open. Kiri sets KWin's focus policy to "Click to focus" when installing</string></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Max scroll</string></property><property name="toolTip"><string>Like niri's max-scroll-amount: do not focus a window that needs more scrolling than this to be fully shown, in percent of the screen width</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QSpinBox" name="kcfg_focusFollowsMouseMaxScroll"><property name="suffix"><string> %</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="toolTip"><string>Like niri's max-scroll-amount: do not focus a window that needs more scrolling than this to be fully shown, in percent of the screen width</string></property></widget></item><item row="2" column="1"><widget class="QCheckBox" name="kcfg_cursorFollowsFocus"><property name="text"><string>Cursor follows keyboard focus</string></property><property name="toolTip"><string>Move the mouse cursor to a window focused from the keyboard (niri: warp-mouse-to-focus)</string></property></widget></item><item row="3" column="1"><widget class="QCheckBox" name="kcfg_skipSwitcher"><property name="text"><string>Hide tiled windows from Alt+Tab</string></property><property name="toolTip"><string>Hide tiled windows from the window switcher</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Mouse wheel and buttons</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>One bind per line: Modifiers+Trigger=action@cooldown ms. Hover over the box for the triggers.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_pointerBinds"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>One bind per line, like niri's Mod+WheelScrollDown binds: &lt;modifiers&gt;+&lt;trigger&gt;=&lt;Kiri action&gt;[@&lt;cooldown ms&gt;], for example Meta+WheelScrollDown=desktop-next@150. Triggers: WheelScrollUp/Down/Left/Right, MouseLeft/Right/Middle/Back/Forward. The action is a name from the Shortcuts list. Blank lines are ignored; a semicolon between binds works too</string></property><property name="placeholderText"><string>Meta+WheelScrollDown=desktop-next@150</string></property><property name="minimumSize"><size><width>0</width><height>150</height></size></property><property name="maximumSize"><size><width>16777215</width><height>150</height></size></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Dragging windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_untileOnDrag"><property name="text"><string>Float a window when it is dragged</string></property><property name="toolTip"><string>Dragging a tiled window takes it out of the grid</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_dropToTile"><property name="text"><string>Tile a window where it is dropped</string></property><property name="toolTip"><string>Like niri: a window dragged out of the grid goes back in at the gap closest to the cursor when you let go</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_resizeNeighborColumn"><property name="text"><string>Resize the neighbouring column too</string></property><property name="toolTip"><string>When dragging a column's edge, inversely resize the column on the other side</string></property></widget></item></layout></widget></item><item><spacer name="spacer_FocusMouse"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_Animations"><attribute name="title"><string>Animations</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_Animations"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_Animations"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Closing windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Delay before the gap closes</string></property><property name="toolTip"><string>Wait this long before the other columns close the gap, so the closing animation can finish</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QSpinBox" name="kcfg_closeRelayoutDelay"><property name="suffix"><string> ms</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="specialValueText"><string>None</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>5000</number></property><property name="toolTip"><string>Wait this long before the other columns close the gap, so the closing animation can finish</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>All animations</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="1"><widget class="QCheckBox" name="kcfg_animationsOff"><property name="text"><string>Turn off all animations</string></property><property name="toolTip"><string>Like niri's `off` in the animations block: every animation ends at once</string></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Slow down by</string></property><property name="toolTip"><string>Like niri's `slowdown`: all animations take this many times as long. Below 1 they are faster. It comes on top of Plasma's animation speed</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QDoubleSpinBox" name="kcfg_animationsSlowdown"><property name="decimals"><number>2</number></property><property name="suffix"><string> x</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>100.0</double></property><property name="singleStep"><double>0.1</double></property><property name="toolTip"><string>Like niri's `slowdown`: all animations take this many times as long. Below 1 they are faster. It comes on top of Plasma's animation speed</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Open</string></property><property name="toolTip"><string>niri's window-open (a new window scales up and fades in). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="kcfg_animWindowOpen"><property name="toolTip"><string>niri's window-open (a new window scales up and fades in). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>ease-out-expo 150</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Close</string></property><property name="toolTip"><string>niri's window-close (a closing window shrinks and fades out). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QLineEdit" name="kcfg_animWindowClose"><property name="toolTip"><string>niri's window-close (a closing window shrinks and fades out). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>ease-out-quad 150</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="2" column="0"><widget class="QLabel"><property name="text"><string>Movement</string></property><property name="toolTip"><string>niri's window-movement (windows that move to a new place; a move that only goes sideways uses the view movement below). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="kcfg_animWindowMovement"><property name="toolTip"><string>niri's window-movement (windows that move to a new place; a move that only goes sideways uses the view movement below). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>spring 1 800 0.0001</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="3" column="0"><widget class="QLabel"><property name="text"><string>Resize</string></property><property name="toolTip"><string>niri's window-resize (the old contents cross-fade into the new ones). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="3" column="1"><widget class="QLineEdit" name="kcfg_animWindowResize"><property name="toolTip"><string>niri's window-resize (the old contents cross-fade into the new ones). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>spring 1 800 0.0001</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>View and desktops</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>View movement</string></property><property name="toolTip"><string>niri's horizontal-view-movement (the columns scroll sideways, also where a touchpad swipe settles). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="kcfg_animHorizontalViewMovement"><property name="toolTip"><string>niri's horizontal-view-movement (the columns scroll sideways, also where a touchpad swipe settles). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>spring 1 800 0.0001</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Desktop switch</string></property><property name="toolTip"><string>niri's workspace-switch (also where the desktops settle after a swipe or drag). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QLineEdit" name="kcfg_animWorkspaceSwitch"><property name="toolTip"><string>niri's workspace-switch (also where the desktops settle after a swipe or drag). Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>spring 1 1000 0.0001</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item><item row="2" column="0"><widget class="QLabel"><property name="text"><string>Overview</string></property><property name="toolTip"><string>niri's overview-open-close. Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="kcfg_animOverviewOpenClose"><property name="toolTip"><string>niri's overview-open-close. Format: off, or spring DAMPING STIFFNESS EPSILON (niri's spring: 1 800 0.0001), or CURVE MS with the curve one of linear, ease-out-quad, ease-out-cubic, ease-out-expo (ease-out-expo 150), or cubic-bezier MS X1 Y1 X2 Y2</string></property><property name="placeholderText"><string>spring 1 800 0.0001</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item></layout></widget></item><item><spacer name="spacer_Animations"><property name="orientation"><enum>Qt::Vertical</enum></property><pr