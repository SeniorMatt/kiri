e="singleStep"><double>0.1</double></property><property name="toolTip"><string>Blur radius of the shadow</string></property></widget></item><item row="2" column="0"><widget class="QLabel"><property name="text"><string>Spread</string></property><property name="toolTip"><string>How far the shadow grows past the desktop</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="2" column="1"><widget class="QDoubleSpinBox" name="kcfg_overviewShadowSpread"><property name="decimals"><number>2</number></property><property name="suffix"><string> px</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><double>-1024</double></property><property name="maximum"><double>1024</double></property><property name="singleStep"><double>0.1</double></property><property name="toolTip"><string>How far the shadow grows past the desktop</string></property></widget></item><item row="3" column="0"><widget class="QLabel"><property name="text"><string>Offset X</string></property><property name="toolTip"><string>Horizontal shift of the shadow</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="3" column="1"><widget class="QDoubleSpinBox" name="kcfg_overviewShadowOffsetX"><property name="decimals"><number>2</number></property><property name="suffix"><string> px</string></property><property name="minimumSize"><size><width>130</width><height>0</height></size></property><property name="minimum"><double>-999</double></property><property name="maximum"><double>999</double></property><property name="singleStep"><double>0.1</double></property><property name="toolTip"><string>H