</layout></item><item><spacer name="spacer_shortcuts_9"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget></widget></item></layout></item></layout></widget><widget class="QWidget" name="tab_Advanced"><attribute name="title"><string>Advanced</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_Advanced"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_Advanced"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Stacking order</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Tiled windows</string></property><property name="toolTip"><string>Sets "Keep Below" on tiled windows so floating ones stay on top</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QRadioButton" name="kcfg_tiledKeepBelow"><property name="text"><string>Keep below</string></property><property name="toolTip"><string>Sets "Keep Below" on tiled windows so floating ones stay on top</string></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Floating windows</string></property><property name="toolTip"><string>Sets "Keep Above" on floating windows</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QRadioButton" name="kcfg_floatingKeepAbove"><property name="text"><string>Keep above</string></property><property name="toolTip"><string>Sets "Keep Above" on floating windows</string></property></widget></item><item row="2" column="1"><widget class="QRadioButton" name="kcfg_noLayering"><property name="text"><string>Do not change it</string></property><property name="toolTip"><string>Leave the stacking order to KWin</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Desktops</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Dynamic desktops</string></property><property name="toolTip"><string>Experimental, off by default. Like niri's workspaces: there is always one empty desktop at the bottom, and empty desktops are removed when you leave them. Moving a window or column down from the last desktop opens a new one</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="0" column="1"><widget class="QCheckBox" name="kcfg_dynamicDesktops"><property name="text"><string>Always keep one empty desktop (experimental)</string></property><property name="toolTip"><string>Experimental, off by default. Like niri's workspaces: there is always one empty desktop at the bottom, and empty desktops are removed when you leave them. Moving a window or column down from the last desktop opens a new one</string></property></widget></item><item row="1" column="0"><widget class="QLabel"><property name="text"><string>Tiled desktops</string></property><property name="toolTip"><string>Regular expression matched against the virtual desktop names. Only matching desktops are tiled</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="minimumSize"><size><width>170</width><height>0</height></size></property></widget></item><item row="1" column="1"><widget class="QLineEdit" name="kcfg_tiledDesktops"><property name="toolTip"><string>Regular expression matched against the virtual desktop names. Only matching desktops are tiled</string></property><property name="placeholderText"><string>.* (all)</string></property><property name="clearButtonEnabled"><bool>true</bool></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Import niri config</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::ExpandingFieldsGrow</enum></property><property name="labelAlignment"><set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set></property><property name="verticalSpacing"><number>6</number></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Kiri applies the pasted config on top of the other tabs. Hover over the box for what it reads.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_niriConfigEnabled"><property name="text"><string>Use this niri config</string></property><property name="toolTip"><string>When off, the pasted text is kept but not used</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_niriConfig"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>Paste your niri config.kdl (usually ~/.config/niri/config.kdl). Kiri reads it every time the settings change and applies it on top of the other tabs, so the values it sets win. It sets: key binds (keys typed in the Shortcuts tab still win), gaps and struts, center-focused-column, always-center-single-column, preset widths and heights, default column width and display, focus ring, border, tab indicator, warp-mouse-to-focus, and window rules with open-floating or default-column-width. Everything else is ignored; lines Kiri can't use are listed in the KWin log.</string></property><property name="placeholderText"><string>layout {
    gaps 16
}
binds {
    Mod+H { focus-column-left; }
}</string></property><property name="minimumSize"><size><width>0</width><height>252</height></size></property></widget></item></layout></widget></item><item><spacer name="spacer_Advanced"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget></widget></item></layout></widget>
