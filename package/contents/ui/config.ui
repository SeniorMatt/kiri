e="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_untileOnDrag"><property name="text"><string>Float a window when it is dragged</string></property><property name="toolTip"><string>Dragging a tiled window takes it out of the grid</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tabbedColumnsByDefault"><property name="text"><string>New columns are tabbed</string></property><property name="toolTip"><string>New columns start in tabbed display (only the active window is visible)</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_cursorFollowsFocus"><property name="text"><string>Cursor follows focus (experimental)</string></property><property name="toolTip"><string>Move the mouse cursor to a window when it gains focus</string></property></widget></item><item row="3" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_skipSwitcher"><property name="text"><string>Tiled windows skip Alt+Tab</string></property><property name="toolTip"><string>Hide tiled windows from the window switcher</string></property></widget></item><item row="4" column="0"><widget class="QLabel"><property name="text"><string>Tiled desktops:</string></property><property name="toolTip"><string>Regex matched against virtual desktop names. Only matching desktops are tiled</string></property></widget></item><item row="4" column="1"><widget class="QLineEdit" name="kcfg_tiledDesktops"><property name="toolTip"><string>Regex matched against virtual desktop names. Only matching desktops are tiled</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Maximized and full-screen windows</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tileMaximized"><property name="text"><string>Keep maximized windows in the grid</string></property><property name="toolTip"><string>They stay in their column and fill the work area; they stay maximized when focus moves away</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_tileFullScreen"><property name="text"><string>Keep full-screen windows in the grid</string></property><property name="toolTip"><string>They stay in their column and fill the screen; you can scroll past them</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_reMaximize"><property name="text"><string>Restore maximized state on focus</string></property><property name="toolTip"><string>Re-maximize and re-fullscreen tiled windows when they are focused again</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Stacking order</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0" colspan="2"><widget class="QRadioButton" name="kcfg_tiledKeepBelow"><property name="text"><string>Tiled windows are kept below</string></property><property name="toolTip"><string>Sets "Keep Below" on tiled windows so floating ones stay on top</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QRadioButton" name="kcfg_floatingKeepAbove"><property name="text"><string>Floating windows are kept above</string></property><property name="toolTip"><string>Sets "Keep Above" on floating windows</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QRadioButton" name="kcfg_noLayering"><property name="text"><string>Do not change the stacking order</string></property></widget></item></layout></widget></item><item><spacer name="spacer_behavior"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_gestures"><attribute name="title"><string>Gestures and Animations</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_gestures"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_gestures"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Touchpad gestures (Wayland only)</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_gestureScroll"><property name="text"><string>Scroll with a three-finger horizontal swipe</string></property></widget></item><item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_gestureScrollInvert"><property name="text"><string>Natural scrolling</string></property><property name="toolTip"><string>Invert the swipe direction</string></property></widget></item><item row="2" column="0"><widget class="QLabel"><property name="text"><string>Scroll distance per swipe:</string></property><property name="toolTip"><string>Distance scrolled by one edge-to-edge swipe</string></property></widget></item><item row="2" column="1"><widget class="QSpinBox" name="kcfg_gestureScrollStep"><property name="suffix"><string> px</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>99999</number></property><property name="toolTip"><string>Distance scrolled by one edge-to-edge swipe</string></property></widget></item><item row="3" column="0"><widget class="QLabel"><property name="text"><string>Settle time:</string></property><property name="toolTip"><string>How long the view keeps following the fingers' momentum after release</string></property></widget></item><item row="3" column="1"><widget class="QSpinBox" name="kcfg_gestureSettleDuration"><property name="suffix"><string> ms</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>5000</number></property><property name="toolTip"><string>How long the view keeps following the fingers' momentum after release</string></property></widget></item><item row="4" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_gestureDesktopSwitch"><property name="text"><string>Switch desktops with a vertical swipe</string></property><property name="toolTip"><string>Three-finger swipe up/down changes the virtual desktop</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Animations</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0"><widget class="QLabel"><property name="text"><string>Delay after closing a window:</string></property><property name="toolTip"><string>Wait this long before the other columns close the gap, so the closing animation can finish</string></property></widget></item><item row="0" column="1"><widget class="QSpinBox" name="kcfg_closeRelayoutDelay"><property name="suffix"><string> ms</string></property><property name="minimum"><number>0</number></property><property name="maximum"><number>5000</number></property><property name="toolTip"><string>Wait this long before the other columns close the gap, so the closing animation can finish</string></property></widget></item></layout></widget></item><item><spacer name="spacer_gestures"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_windowRules"><attribute name="title"><string>Window Rules</string></attribute><layout class="QVBoxLayout"><property name="margin"><number>0</number></property><item><widget class="QScrollArea" name="scroll_windowRules"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_windowRules"><layout class="QVBoxLayout"><item><widget class="QGroupBox"><property name="title"><string>Simple rules</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>One entry per line. Entries are window classes (regular expressions are allowed, e.g. org\.kde\..*). Find a class with: qdbus6 org.kde.KWin /KWin org.kde.KWin.queryWindowInfo</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Always float these windows:</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_floatClasses"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>Window classes that are never tiled</string></property><property name="minimumSize"><size><width>0</width><height>64</height></size></property><property name="maximumSize"><size><width>16777215</width><height>64</height></size></property><property name="placeholderText"><string>calc
mpv</string></property></widget></item><item row="3" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Always tile these windows:</string></property></widget></item><item row="4" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_tileClasses"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>Window classes that are always tiled, even if Kiri would float them</string></property><property name="minimumSize"><size><width>0</width><height>64</height></size></property><property name="maximumSize"><size><width>16777215</width><height>64</height></size></property><property name="placeholderText"><string>kfind</string></property></widget></item><item row="5" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Column width per window:</string></property></widget></item><item row="6" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_columnWidthRules"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>One class=width per line, like firefox=66.667%</string></property><property name="minimumSize"><size><width>0</width><height>64</height></size></property><property name="maximumSize"><size><width>16777215</width><height>64</height></size></property><property name="placeholderText"><string>firefox=66.667%
org\.kde\.dolphin=800px</string></property></widget></item></layout></widget></item><item><widget class="QGroupBox"><property name="title"><string>Advanced: JSON rules</string></property><layout class="QFormLayout"><property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property><item row="0" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>Rules with a caption match, applied together with the simple rules above. Fields: class, caption (regexes), tile (true/false), width. Example: {"class": "steam", "caption": "Friends List", "tile": false}</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="1" column="0" colspan="2"><widget class="QLabel"><property name="text"><string>JSON list:</string></property></widget></item><item row="2" column="0" colspan="2"><widget class="QPlainTextEdit" name="kcfg_windowRules"><property name="tabChangesFocus"><bool>true</bool></property><property name="lineWrapMode"><enum>QPlainTextEdit::NoWrap</enum></property><property name="font"><font><family>Monospace</family></font></property><property name="toolTip"><string>A JSON array of rule objects</string></property><property name="minimumSize"><size><width>0</width><height>220</height></size></property></widget></item></layout></widget></item><item><spacer name="spacer_windowRules"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item></layout></widget></widget></item></layout></widget><widget class="QWidget" name="tab_shortcuts"><attribute name="title"><string>Shortcuts</string></attribute><layout class="QVBoxLayout"><item><widget class="QLabel" name="label_shortcutsRule"><property name="text"><string>Keys set here take priority and are copied to the Kiri group in System Settings &gt; Shortcuts, without a conflict check. Leave both fields empty to use the keys set in System Settings.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item><widget class="QScrollArea" name="scroll_shortcuts"><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="widgetResizable"><bool>true</bool></property><widget class="QWidget" name="scrollContents_shortcuts"><layout class="QGridLayout" name="grid_shortcuts">
